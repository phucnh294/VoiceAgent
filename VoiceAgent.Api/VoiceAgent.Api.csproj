<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- SpaProxy: starting the API (http/https profiles) also starts the Angular dev server -->
    <SpaRoot>..\VoiceAgent-Client\</SpaRoot>
    <SpaProxyLaunchCommand>npm run serve</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>http://127.0.0.1:53034</SpaProxyServerUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VoiceAgent.Api.Tests" />
  </ItemGroup>

</Project>
